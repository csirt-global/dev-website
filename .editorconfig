# Keep diffs about content, not whitespace.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown. Rare here, but real.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.{png,jpg,jpeg,gif,webp,ico,svg,woff2,pdf}]
trim_trailing_whitespace = false
insert_final_newline = false
